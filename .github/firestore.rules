rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───── 기본 도우미 ─────
    // 구글 로그인 + 이메일 인증이 된 사람만
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    // 앱 주인(최고 관리자) 이메일 — firebase-config.js 의 OWNER_EMAIL 과 같아야 해요
    function isOwner() {
      return signedIn() && me() == 'artist4rhythm@gmail.com';
    }
    function tPath() {
      return /databases/$(database)/documents/teachers/$(me());
    }
    function hasT() {
      return signedIn() && exists(tPath());
    }
    function myRole() {
      return get(tPath()).data.get('role', 'teacher');
    }
    // 관리자 = 디렉터 또는 시스템 관리자(데이터 담당) — 앱 안의 내용 수정
    function isAdmin() {
      return isOwner() || (hasT() && myRole() in ['admin', 'director']);
    }
    // 디렉터 본인 (수퍼관리자 제외) — 교사 돌봄 기록은 디렉터와 쓴 사람만
    function isDirectorRole() {
      return hasT() && myRole() == 'director';
    }
    // 디렉터 = 조이코너 전체 관리 장 (시스템 관리자 지정 가능)
    function isDirector() {
      return isOwner() || (hasT() && myRole() == 'director');
    }
    // 권한 바꾸기 규칙: 수퍼관리자 > 디렉터 > 관리자 > 교사
    //  - 디렉터는 수퍼관리자만 정하고 바꿔요
    //  - 관리자는 수퍼관리자와 디렉터가 정해요
    //  - 관리자는 교사만 등록·수정해요
    function canWriteRole(newRole, oldRole) {
      return isOwner()
        || (isDirector() && newRole != 'director' && oldRole != 'director')
        || (isAdmin() && !(newRole in ['admin', 'director']) && !(oldRole in ['admin', 'director']));
    }
    function isStaff() {
      return isAdmin() || hasT();
    }
    // v13 — 닫힌 앱이라 모든 선생님이 모든 반을 보고 출석도 누구나 해요
    function inClass(c) {
      return isStaff();
    }

    // ───── 로그인 권한 (구글 계정 이메일별) ─────
    match /teachers/{email} {
      allow read: if isAdmin() || (signedIn() && me() == email);
      allow create: if canWriteRole(request.resource.data.get('role', 'teacher'), 'teacher');
      allow update: if canWriteRole(request.resource.data.get('role', 'teacher'), resource.data.get('role', 'teacher'));
      allow delete: if canWriteRole('teacher', resource.data.get('role', 'teacher'));
    }

    // ───── 교사 명단 (구글 연결 전에도 미리 만들어 두는 명단) ─────
    match /staff/{id} {
      allow read: if isStaff();
      allow create: if canWriteRole(request.resource.data.get('role', 'teacher'), 'teacher');
      // 본인은 자기 카드의 사진·연락처·생일·소개만 고칠 수 있어요
      allow update: if canWriteRole(request.resource.data.get('role', 'teacher'), resource.data.get('role', 'teacher'))
                    || (signedIn() && resource.data.get('email', '') == me()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'birth', 'intro', 'thumb', 'photo', 'jin', 'cell']));
      allow delete: if canWriteRole('teacher', resource.data.get('role', 'teacher'));
    }

    // ───── 교사 영혼 카드: 사진 · 돌봄 기록 ─────
    match /staffPhotos/{id} {
      allow read: if isStaff();
      allow write: if isAdmin()
                   || (isStaff() && get(/databases/$(database)/documents/staff/$(id)).data.get('email', '') == me());
    }
    // v28 — 공지 알림: 알림 받는 기기 (본인 것만 등록 · 지우기, 목록은 관리자)
    match /pushTokens/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.email == me());
      allow create, update: if isStaff() && request.resource.data.email == me();
      allow delete: if isAdmin() || (isStaff() && resource.data.email == me());
    }
    // v28 — 알림 보낼 일: 관리자가 공지를 올릴 때 만들고, 보내기 도우미(서버 열쇠)만 처리해요
    match /pushQueue/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == me() && request.resource.data.status == 'wait';
      allow update, delete: if false;
    }
    // v22 — 선생님 주소: 디렉터 · 관리자와 본인만
    match /staffPrivate/{id} {
      allow read, write: if isAdmin()
                         || (isStaff() && get(/databases/$(database)/documents/staff/$(id)).data.get('email', '') == me());
    }
    match /staffNotes/{id} {
      // 디렉터와 쓴 사람만 봐요 (시스템 관리자는 못 봐요)
      allow read: if isDirectorRole() || (isStaff() && resource.data.by == me());
      // 쓰는 사람: 디렉터·수퍼관리자, 또는 그 카드의 선생님 본인
      allow create: if isStaff() && request.resource.data.by == me()
                    && (isDirector()
                        || get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.get('email', '') == me());
      allow delete: if isDirectorRole() || (isStaff() && resource.data.by == me());
    }

    // ───── 반 (5세반·6세반·7세반) ─────
    match /classes/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ───── 아이들 ─────
    match /children/{id} {
      allow read: if inClass(resource.data.classId);
      allow create: if inClass(request.resource.data.classId);
      // 반 이동(classId) · 졸업 · 학년 이력(years) 바꾸기는 디렉터 · 관리자만 (v32)
      allow update: if inClass(resource.data.classId)
                    && (isAdmin()
                        || (request.resource.data.classId == resource.data.classId
                            && request.resource.data.get('status', 'active') != 'graduated'
                            && resource.data.get('status', 'active') != 'graduated'
                            && request.resource.data.get('years', null) == resource.data.get('years', null)
                            && request.resource.data.get('gradYear', null) == resource.data.get('gradYear', null)));
      allow delete: if isAdmin();
    }

    // ───── 가정 (부모님 정보) ─────
    match /families/{id} {
      allow read, create: if isStaff();
      allow update: if isAdmin() || (isStaff() && request.resource.data.classIds == resource.data.classIds);
      allow delete: if isAdmin();
    }

    // ───── 사진 (대표/추가 사진) ─────
    match /photos/{id} {
      allow read: if inClass(resource.data.classId);
      allow create: if inClass(request.resource.data.classId);
      allow update: if inClass(resource.data.classId)
                    && (request.resource.data.classId == resource.data.classId || isAdmin());
      allow delete: if isAdmin();
    }

    // ───── 출석 (반 + 주일 하나당 문서 하나) ─────
    // v19 — 출석 마감: 잠긴 출석부는 디렉터 · 관리자, 또는 마감한 선생님만 바꿔요
    //        지난 주일은 수요일부터 저절로 잠겨요 (일부러 푼 경우 locked == false 만 빼고)
    function attPast(ds) {
      return request.time > timestamp.date(int(ds.split('-')[0]), int(ds.split('-')[1]), int(ds.split('-')[2])) + duration.value(3, 'd');
    }
    function attLockedNow(d) {
      return d.get('locked', null) == true || (d.get('locked', null) != false && attPast(d.date));
    }
    match /attendance/{id} {
      allow read: if inClass(resource.data.classId);
      allow create: if inClass(request.resource.data.classId);
      allow update: if inClass(resource.data.classId)
                    && request.resource.data.classId == resource.data.classId
                    && (isAdmin()
                        || !attLockedNow(resource.data)
                        || (resource.data.get('locked', null) == true && resource.data.get('lockedBy', '') == me() && !attPast(resource.data.date)));
      allow delete: if isAdmin();
    }
    // v19 — 출석 기록 (쓰기만, 고치거나 지울 수 없어요)
    match /attlog/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.by == me();
      allow update, delete: if false;
    }

    // ───── 돌봄 기록 ─────
    match /careNotes/{id} {
      allow read: if inClass(resource.data.classId);
      allow create: if inClass(request.resource.data.classId)
                    && request.resource.data.by == me();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (inClass(resource.data.classId) && resource.data.by == me());
    }

    // ───── 주일 일정 (설교, 헌금기도 등) ─────
    match /schedule/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ───── 설교 (교사가 올리고 디렉터·교사가 댓글) ─────
    match /sermons/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.authorEmail == me();
      // 작성자는 그대로 두고, 본인 또는 관리자·디렉터만 고쳐요
      allow update: if isStaff()
                    && request.resource.data.authorEmail == resource.data.authorEmail
                    && (resource.data.authorEmail == me() || isAdmin());
      allow delete: if isAdmin() || (isStaff() && resource.data.authorEmail == me());
    }

    // ───── 댓글 ─────
    match /comments/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.by == me();
      allow delete: if isAdmin() || (isStaff() && resource.data.by == me());
    }

    // ───── 주별 악보 · 예배 순서 기록 ─────
    match /setlists/{date} {
      allow read, write: if isStaff();
    }
    match /songs/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin() || (isStaff() && resource.data.by == me());
    }
    match /scorePages/{id} {
      allow read, write: if isStaff();
    }

    // ───── 업무 분담 · 설교 표준 순서(참고) ─────
    match /duties/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /stories/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ───── 공지 게시판 (디렉터·관리자가 올리고 모든 교사가 봐요) ─────
    match /notices/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /noticeImages/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ───── 캘린더 일정 (교사 누구나 올리고, 본인 또는 관리자가 고쳐요) ─────
    match /events/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.by == me();
      allow update: if isStaff()
                    && request.resource.data.by == resource.data.by
                    && (resource.data.by == me() || isAdmin());
      allow delete: if isAdmin() || (isStaff() && resource.data.by == me());
    }

    // ───── 사용 현황 (수퍼관리자만 봐요, 각자 자기 기록만 더해요) ─────
    match /usage/{id} {
      allow read: if isOwner();
      allow create, update: if isStaff() && request.resource.data.email == me()
                            && id == me() + '_' + request.resource.data.date;
    }
    // 접속 기록 (v33): 본인 것만 쓰고, 보기 · 정리는 수퍼관리자만
    match /sessions/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isStaff() && request.resource.data.email == me()
                            && id == me() + '_' + string(request.resource.data.start);
    }

    // ───── v32 · 신입 명단 · 새 학년 기록 · 졸업 가정 연락처 ─────
    // 신입 명단: 모든 선생님이 보고 (새 반 선생님 미리 보기), 고치는 건 디렉터 · 관리자
    match /incoming/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    // 새 학년 준비: 초안은 디렉터 · 관리자가 함께, 시작 · 되돌리기는 디렉터만
    match /promotions/{year} {
      allow read: if isStaff();
      allow write: if isDirector()
                   || (isAdmin()
                       && request.resource.data.get('status', 'draft') == 'draft'
                       && (resource == null || resource.data.get('status', 'draft') in ['draft', 'undone']));
    }
    // 졸업 가정의 부모님 연락처 (동생이 조이코너에 없는 가정): 디렉터 · 관리자만
    match /gradContacts/{id} {
      allow read, write: if isAdmin();
    }

    // ───── 일정 사진 ─────
    match /eventImages/{id} {
      allow read, write: if isStaff();
    }

    // ───── v10 · 공휴일 (관리자가 해마다 불러오고, 모두가 봐요) ─────
    match /holidays/{year} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    // ───── v10 · 바깥 캘린더 가져온 기록 (묶음째 지우기용) ─────
    match /imports/{id} {
      allow read, write: if isAdmin();
    }
    // ───── v10 · 앱 설정 (구글 연결 클라이언트 ID — 공개돼도 괜찮은 값) ─────
    match /config/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    // ───── v10 · 내 구글 캘린더 연결 상태 (본인만 읽고 써요) ─────
    match /gcal/{email} {
      allow read, write: if hasT() && me() == email;
    }

    // ───── v11 · 주일 인원 (교사 누구나 넣고, 지우기는 관리자) ─────
    match /counts/{date} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ───── v13 · 주일 자료 링크 (파일은 구글 드라이브, 여기엔 링크만) ─────
    match /materials/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.by == me();
      allow update, delete: if isAdmin() || (isStaff() && resource.data.by == me());
    }

    // ───── v20 · 임시 저장 (본인만) ─────
    match /drafts/{id} {
      allow read, update, delete: if hasT() && resource.data.owner == me();
      allow create: if hasT() && request.resource.data.owner == me();
    }
    // ───── v20 · 글 양식 (모두 보고, 만든 사람 · 관리자가 지워요) ─────
    match /templates/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.by == me();
      allow update, delete: if isAdmin() || (isStaff() && resource.data.by == me());
    }

    // 그 밖의 모든 것은 막아요
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
